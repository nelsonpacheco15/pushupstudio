# Copy this file to .env.local and fill it in.

# ── Supabase (auth + data store) ──
# Project Settings → API. URL like https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The SECRET service_role / sb_secret_ key. Server-only, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ── Groq (ALL AI: voice transcription + brief formatting + stylescape suggestions) ──
# console.groq.com → API Keys (free tier)
GROQ_API_KEY=

# ── Studio login ──
# The password you type to reach the admin side. Leave BLANK to disable the gate
# (local dev only). ALWAYS set a strong value before deploying.
STUDIO_PASSWORD=

# ── Email notifications (Resend — optional; every email no-ops if unset) ──
# resend.com → API Keys
RESEND_API_KEY=
# Verified sender. Until you verify your own domain in Resend, use the test
# sender below. Later: "PushUP Studio <studio@yourdomain.com>"
EMAIL_FROM=PushUP Studio <onboarding@resend.dev>
# Address that receives studio notifications (new client / new request).
STUDIO_EMAIL=
# Public base URL used in the links inside emails. Set to your Vercel URL
# after deploying, e.g. https://pushup-studio.vercel.app
APP_URL=http://localhost:3000

# ── Optional model overrides ──
# GROQ_WHISPER_MODEL=whisper-large-v3
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
